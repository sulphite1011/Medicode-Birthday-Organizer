rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Projects collection: Accessible by authenticated owner
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() <= 150;
      allow update: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
      allow delete: if isSignedIn() && isValidId(projectId);
    }

    // Client requests / orders collection: Accessible by authenticated owner
    match /client_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(requestId)
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() <= 150;
      allow update: if isSignedIn()
        && isValidId(requestId);
      allow delete: if isSignedIn() && isValidId(requestId);
    }

    // App settings
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(settingId);
    }
  }
}
